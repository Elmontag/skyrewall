# BlueSky App (no configuration needed for stateless tool)

# Database credentials (change POSTGRES_PASSWORD to a strong random value!)
# Generate a password: openssl rand -hex 32
POSTGRES_USER=skyrewall
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=skyrewall

# Database connection string (must match credentials above)
DATABASE_URL=postgresql://skyrewall:your-strong-password-here@postgres:5432/skyrewall

# Encryption key for stored credentials (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-byte-hex-key-here-replace-this

# Background sync interval in minutes (how often subscriptions are processed)
SYNC_INTERVAL_MINUTES=60

# Next.js
NODE_ENV=development
